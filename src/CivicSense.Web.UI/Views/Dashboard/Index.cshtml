@using CivicSense.Entities
@using System.Security.Claims

@inject CivicSense.Facade.Interface.IPermissionService Permissions

@{
    ViewData["Title"] = "CivicSense Dashboard";

    bool hasUserId = int.TryParse(
        User.FindFirstValue(ClaimTypes.NameIdentifier),
        out int actorId);

    bool canManageCategories =
        hasUserId &&
        await Permissions.HasPermissionAsync(
            actorId,
            PermissionCodes.ManageCategories);

    bool canManageAccess =
        hasUserId &&
        User.IsInRole("Admin") &&
        await Permissions.HasPermissionAsync(
            actorId,
            PermissionCodes.ManageAccess);
}

<h2>CivicSense Dashboard</h2>

<hr />

<div class="card mb-4">

    <div class="card-body">

        <h5>
            Welcome, @ViewBag.FullName
        </h5>

        <p>
            <strong>User ID:</strong>
            @ViewBag.UserId
        </p>

        <p>
            <strong>Role:</strong>
            @ViewBag.Role
        </p>

        <p class="text-success mb-0">
            Authentication successful.
        </p>

    </div>

</div>

<h4>Quick Actions</h4>

<div class="d-flex flex-wrap gap-2 mb-4">

    @if (User.IsInRole("Resident"))
    {
        <a asp-controller="Issue"
           asp-action="Index"
           class="btn btn-primary">
            My Issues
        </a>

        <a asp-controller="Issue"
           asp-action="Create"
           class="btn btn-success">
            Report New Issue
        </a>
    }

    @if (User.IsInRole("Admin"))
    {
        <a asp-controller="IssueWorkflow"
           asp-action="AdminQueue"
           class="btn btn-primary">
            Civic Issue Review Queue
        </a>
    }

    @if (User.IsInRole("Staff"))
    {
        <a asp-controller="IssueWorkflow"
           asp-action="MyAssignments"
           class="btn btn-primary">
            My Assigned Issues
        </a>
    }

    <a asp-controller="Category"
       asp-action="Index"
       class="btn btn-outline-secondary">

        @(canManageCategories
            ? "Manage Categories"
            : "Browse Categories")

    </a>

    <a asp-controller="Notification"
       asp-action="Index"
       class="btn btn-outline-primary">
        My Notifications
    </a>

</div>

@if (canManageAccess)
{
    <hr />

    <h4>Access Administration</h4>

    <div class="row mb-4">

        <div class="col-md-6 mb-3">

            <div class="card h-100">

                <div class="card-body">

                    <h5 class="card-title">
                        User Management
                    </h5>

                    <p class="card-text">
                        Create accounts, edit user information,
                        assign groups and manage individual
                        permissions.
                    </p>

                    <a asp-controller="AccessAdmin"
                       asp-action="Users"
                       class="btn btn-primary">
                        Manage Users
                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-6 mb-3">

            <div class="card h-100">

                <div class="card-body">

                    <h5 class="card-title">
                        Permission Groups
                    </h5>

                    <p class="card-text">
                        Create custom permission groups
                        and configure access privileges.
                    </p>

                    <a asp-controller="AccessAdmin"
                       asp-action="Groups"
                       class="btn btn-primary">
                        Manage Permission Groups
                    </a>

                </div>

            </div>

        </div>

    </div>
}

<hr />

<form asp-controller="Account"
      asp-action="Logout"
      method="post">

    @Html.AntiForgeryToken()

    <button type="submit"
            class="btn btn-outline-danger">
        Logout
    </button>

</form>