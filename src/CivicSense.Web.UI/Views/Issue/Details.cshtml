@model CivicSense.Facade.DTOs.IssueDto

@using System.Security.Claims
@using CivicSense.Entities

@{
    ViewData["Title"] = "Issue Details";

    bool isOwner =
        User.FindFirstValue(ClaimTypes.NameIdentifier)
        == Model.ReporterId.ToString();

    bool canEdit =
        isOwner &&
        (Model.Status == IssueStatus.Reported ||
         Model.Status == IssueStatus.NeedsInformation);

    bool canArchive =
        isOwner &&
        (Model.Status == IssueStatus.Resolved ||
         Model.Status == IssueStatus.Rejected);
}

<h2>@Model.Title</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="status">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<dl class="row">

    <dt class="col-sm-3">Issue ID</dt>
    <dd class="col-sm-9">@Model.Id</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.Description</dd>

    <dt class="col-sm-3">Address</dt>
    <dd class="col-sm-9">@Model.Address</dd>

    <dt class="col-sm-3">Issue Type</dt>
    <dd class="col-sm-9">@Model.IssueType</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Priority</dt>
    <dd class="col-sm-9">@Model.Priority</dd>

    <dt class="col-sm-3">Category ID</dt>
    <dd class="col-sm-9">@Model.CategoryId</dd>

    <dt class="col-sm-3">Reported On</dt>
    <dd class="col-sm-9">
        @Model.CreatedAt.ToString(
            "dd MMM yyyy HH:mm") UTC
    </dd>

    @if (Model.Latitude.HasValue &&
         Model.Longitude.HasValue)
    {
        <dt class="col-sm-3">Location</dt>
        <dd class="col-sm-9">
            @Model.Latitude, @Model.Longitude
        </dd>
    }

</dl>

<hr />

<h4>Issue Discussion</h4>

<p class="text-muted">
    View comments and, if authorized,
    add public comments or internal notes.
</p>

<a asp-controller="IssueComment"
   asp-action="Index"
   asp-route-issueId="@Model.Id"
   class="btn btn-outline-primary mb-3">
    View Comments
</a>

<hr />

<div class="d-flex flex-wrap gap-2">

    @if (canEdit)
    {
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">
            Edit Issue
        </a>
    }

    @if (canArchive)
    {
        <form asp-action="Archive"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-danger"
                    onclick="return confirm('Archive this issue?');">
                Archive Issue
            </button>
        </form>
    }

    @if (User.IsInRole("Resident"))
    {
        <a asp-action="Index"
           class="btn btn-secondary">
            Back to My Issues
        </a>
    }
    else
    {
        <a asp-controller="Dashboard"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Dashboard
        </a>
    }

</div>
