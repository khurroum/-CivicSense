@model List<CivicSense.Facade.DTOs.CategoryDto>

@{
    ViewData["Title"] = "Issue Categories";
    bool isAdmin = User.IsInRole("Admin");
}

<h2>Issue Categories</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="status">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

@if (isAdmin)
{
    <p>
        <a asp-action="Create"
           class="btn btn-primary">
            Add Category
        </a>
    </p>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No categories found.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>

                    @if (isAdmin)
                    {
                        <th>Status</th>
                    }

                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td>@category.Name</td>

                        <td>
                            @(category.Description ??
                                "No description")
                        </td>

                        @if (isAdmin)
                        {
                            <td>
                                @if (category.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inactive
                                    </span>
                                }
                            </td>
                        }

                        <td>
                            <div class="d-flex gap-2 flex-wrap">

                                <a asp-action="Details"
                                   asp-route-id="@category.Id"
                                   class="btn btn-sm btn-outline-info">
                                    Details
                                </a>

                                @if (isAdmin)
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@category.Id"
                                       class="btn btn-sm btn-warning">
                                        Edit
                                    </a>

                                    @if (category.IsActive)
                                    {
                                        <form asp-action="Deactivate"
                                              asp-route-id="@category.Id"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Deactivate this category?');">
                                                Deactivate
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Reactivate"
                                              asp-route-id="@category.Id"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-success"
                                                    onclick="return confirm('Reactivate this category?');">
                                                Reactivate
                                            </button>
                                        </form>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
