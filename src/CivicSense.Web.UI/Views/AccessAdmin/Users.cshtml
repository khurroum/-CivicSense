@model List<CivicSense.Facade.DTOs.AccessUserDto>
@using System.Security.Claims

@{
    ViewData["Title"] = "User Management";

    int.TryParse(
        User.FindFirstValue(ClaimTypes.NameIdentifier),
        out int currentUserId);
}

<h2>User Management</h2>

<p class="text-muted">
    Manage user accounts, permission groups
    and individual access privileges.
</p>

<div class="d-flex gap-2 flex-wrap mb-4">

    <a asp-action="EditUser"
       asp-route-id="0"
       class="btn btn-primary">
        Create New User
    </a>

    <a asp-action="Groups"
       class="btn btn-outline-primary">
        Permission Groups
    </a>

    <a asp-controller="Dashboard"
       asp-action="Index"
       class="btn btn-secondary">
        Dashboard
    </a>

</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No users found.
    </div>
}
else
{
    <div class="table-responsive">

        <table class="table table-striped align-middle">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Base Role</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var account in Model)
                {
                    <tr>

                        <td>@account.Id</td>

                        <td>

                            <strong>@account.FullName</strong>

                            @if (account.Id == currentUserId)
                            {
                                <span class="badge bg-info text-dark">
                                    You
                                </span>
                            }

                        </td>

                        <td>@account.Email</td>

                        <td>@account.RoleName</td>

                        <td>

                            @if (account.IsActive)
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Inactive
                                </span>
                            }

                        </td>

                        <td>

                            <a asp-action="EditUser"
                               asp-route-id="@account.Id"
                               class="btn btn-sm btn-warning">

                                @(account.Id == currentUserId
                                    ? "View Permissions"
                                    : "Edit User & Permissions")

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}